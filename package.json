{
  "name": "catchup-platform",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@sentry/react": "^7.0.0",
    "@sentry/tracing": "^7.0.0",
    "@supabase/supabase-js": "^2.106.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:supabase": "node scripts/smoke-test.js",
    "scan:safety": "! rg \"child_process|dangerouslySetInnerHTML|new Function|eval\\\\(\" src",
    "verify": "npm test -- --run && npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
